__piutmp() {
	# Piu Temp Directory Manager
	case ${1} in
		[sS][tT][aA][rR][tT])
			[[ -d "/tmp/${0}" ]] || mkdir -p "/tmp/${0}" 2> /dev/null 
		;;
		[sS][tT][oO][pP])
			[[ -d "/tmp/${0}" ]] && rm -rf "/tmp/${0}" 2> /dev/null
		;;
		[rR][eE][sS][tT][aA][rR][tT])
			[[ -d "/tmp/${0}" ]] && { rm -rf "/tmp/${0}" 2> /dev/null && mkdir -p "/tmp/${0}" 2> /dev/null ; } 
		;;
	esac
}

__piuplm () {
	# Piu PID Lock Manager
	case ${1} in
		[sS][tT][aA][rR][tT])
			__piutmp start
			echo "piu_pid='${BASHPID}'" > "/tmp/${0}/piu.pid"
		;;
		[sS][tT][oO][pP])
			__piutmp stop
		;;
		[rR][eE][sS][tT][aA][rR][tT])
			__piutmp restart
		;;
	esac
}

bye() {
	__piuplm stop
	exit
}

if [[ -f "/tmp/${0}/piu.pid" ]] ; then
	. "/tmp/${0}/piu.pid"
	echo -e "$(basename ${0}) says: i'm already running on another proccess (${piu_pid}).\nIf you think this is a mistake you can delete my lock file:\n/tmp/${0}/piu.pid"
	exit 1
else
	__piuplm start
fi

trap bye INT

UPDATE_AFTER=43200 # 12 hours

# Load configuration
########################################################################
PIU_CONFIG="${HOME}/.config/piu/piu.conf"

# Default values
DEFAULT_PKGMAN=""  # Empty means auto-detect
NIX_INSTALL_METHOD="auto"
NIX_FLAKES_ENABLED="auto"
NIX_SCOPE="user"
NIX_CHANNEL="nixpkgs"

# Load config if exists
if [[ -f "$PIU_CONFIG" ]]; then
	source "$PIU_CONFIG"
fi

usage() {
cat <<HELP
Cross-platform package manager wrapper

usage: $(basename "$0") OPTION [--cask] [PACKAGE]

   SINGLE PACKAGE ACTIONS
   (i)nstall : install a given package
   (r)emove  : remove a given package
   (p)urge   : remove a given package and any related config files
   (s)earch  : search for a package
   (m)anual  : install a locally downloaded package (e.g.: a .deb file)
   (f)iles   : list files provided by a given package

   UPDATING
   (u)pdate  : update all installed packages
   (c)ache   : update the package cache / repository

               NOTE: update, install, and num-updates will automatically
               update the cache if it is old

   MISC
   (l)ist            : list installed packages
   (nu) num-updates  : number of packages with updates
   (np) num-packages : number of installed packages
   
   CONFIGURATION
   --init-config     : create default configuration file at ~/.config/piu/piu.conf

https://github.com/beyondmeh/piu

Copyright (c) 2017-2023 BeyondMeh
Licensed under the ISC license.
HELP
}

init_config() {
	local config_dir="${HOME}/.config/piu"
	local config_file="${config_dir}/piu.conf"
	
	# Check if config already exists
	if [[ -f "$config_file" ]]; then
		echo "Configuration file already exists at: $config_file"
		echo "To recreate it, please remove the existing file first."
		exit 1
	fi
	
	# Create config directory if it doesn't exist
	if [[ ! -d "$config_dir" ]]; then
		mkdir -p "$config_dir" 2>/dev/null
		if [[ $? -ne 0 ]]; then
			echo "Error: Could not create directory $config_dir"
			exit 1
		fi
	fi
	
	# Find the example config file
	local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
	local example_file="${script_dir}/piu.conf.example"
	
	if [[ -f "$example_file" ]]; then
		# Copy example file
		cp "$example_file" "$config_file"
		echo "Configuration file created at: $config_file"
		echo "Edit this file to customize piu behavior."
	else
		# Create basic config if example doesn't exist
		cat > "$config_file" <<'EOF'
# Piu Configuration File
# ======================

# Nix-specific settings
# =====================

# Installation method: auto, nix-env, nix-profile, flakes
NIX_INSTALL_METHOD="auto"

# Flakes support: auto, yes, no
NIX_FLAKES_ENABLED="auto"

# Installation scope: user, system
NIX_SCOPE="user"

# Channel to use for installations
NIX_CHANNEL="nixpkgs"
EOF
		echo "Configuration file created at: $config_file"
		echo "Edit this file to customize piu behavior."
	fi
	
	exit 0
}

