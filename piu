#
# NixOS / Nix
#
# Nix detection and helper functions
__nix_detect_version() {
	# Returns Nix version (e.g., "2.18.1")
	nix --version 2>/dev/null | grep -oP '\d+\.\d+(\.\d+)?' | head -1
}

__nix_version_ge() {
	# Compare Nix version: returns 0 if current >= required
	# Usage: __nix_version_ge "2.4"
	local required="$1"
	local current=$(__nix_detect_version)
	
	if [[ -z "$current" ]]; then
		return 1
	fi
	
	# Simple version comparison
	printf '%s\n%s\n' "$required" "$current" | sort -V -C
	return $?
}

__nix_detect_flakes() {
	# Detects if flakes are enabled
	# Checks ~/.config/nix/nix.conf and /etc/nix/nix.conf
	local config_files=(
		"$HOME/.config/nix/nix.conf"
		"/etc/nix/nix.conf"
	)
	
	for conf in "${config_files[@]}"; do
		if [[ -f "$conf" ]]; then
			if grep -q "experimental-features.*nix-command.*flakes\|experimental-features.*flakes.*nix-command" "$conf" 2>/dev/null; then
				return 0
			fi
		fi
	done
	
	return 1
}

__nix_detect_nixos() {
	# Detects if running on NixOS
	grep -q -i nixos /etc/os-release 2>/dev/null
}

__nix_get_install_method() {
	# Returns installation method based on config and detection
	local method="$NIX_INSTALL_METHOD"
	
	if [[ "$method" == "auto" ]]; then
		# Auto-detect best method
		if __nix_version_ge "2.4"; then
			# Check flakes support
			local flakes_enabled="$NIX_FLAKES_ENABLED"
			
			if [[ "$flakes_enabled" == "auto" ]]; then
				if __nix_detect_flakes; then
					echo "flakes"
					return 0
				fi
			elif [[ "$flakes_enabled" == "yes" ]]; then
				echo "flakes"
				return 0
			fi
			
			# Nix 2.4+ without flakes
			echo "nix-profile"
			return 0
		else
			# Older Nix version
			echo "nix-env"
			return 0
		fi
	else
		# Use configured method
		echo "$method"
		return 0
	fi
}

__nix_convert_package_name() {
	# Converts package name based on installation method
	# firefox -> nixpkgs.firefox (for nix-env)
	# firefox -> nixpkgs#firefox (for nix profile with flakes)
	local pkg="$1"
	local method=$(__nix_get_install_method)
	
	# If package already has channel/flake prefix, return as-is
	if [[ "$pkg" == *"."* ]] || [[ "$pkg" == *"#"* ]]; then
		# Convert between formats if needed
		if [[ "$method" == "nix-env" ]] && [[ "$pkg" == *"#"* ]]; then
			echo "${pkg/\#/.}"
		elif [[ "$method" == "flakes" ]] && [[ "$pkg" == *"."* ]]; then
			echo "${pkg/\./#}"
		else
			echo "$pkg"
		fi
	else
		# Add channel prefix
		if [[ "$method" == "nix-env" ]]; then
			echo "${NIX_CHANNEL}.${pkg}"
		elif [[ "$method" == "nix-profile" ]]; then
			echo "${NIX_CHANNEL}.${pkg}"
		else
			# flakes
			echo "${NIX_CHANNEL}#${pkg}"
		fi
	fi
}

nix_install() {
	local method=$(__nix_get_install_method)
	local pkg=$(__nix_convert_package_name "$@")
	
	case "$method" in
		nix-env)
			nix-env -iA "$pkg"
			;;
		nix-profile)
			nix profile install "$pkg"
			;;
		flakes)
			nix profile install "$pkg"
			;;
	esac
}

nix_update() {
	local method=$(__nix_get_install_method)
	
	case "$method" in
		nix-env)
			nix-env -u
			;;
		nix-profile|flakes)
			nix profile upgrade '.*'
			;;
	esac
}

nix_remove() {
	local method=$(__nix_get_install_method)
	
	case "$method" in
		nix-env)
			nix-env -e "$@"
			;;
		nix-profile|flakes)
			nix profile remove "$@"
			;;
	esac
}

nix_purge() {
	local method=$(__nix_get_install_method)
	
	case "$method" in
		nix-env)
			nix-env -e "$@" && nix-collect-garbage -d
			;;
		nix-profile|flakes)
			nix profile remove "$@" && nix-collect-garbage -d
			;;
	esac
}

nix_search() {
	# nix search works the same for all methods
	nix search nixpkgs "$@"
}

nix_list() {
	local method=$(__nix_get_install_method)
	
	case "$method" in
		nix-env)
			nix-env -q
			;;
		nix-profile|flakes)
			nix profile list | awk '{print $1}' | sed 's/.*#//'
			;;
	esac
}
nix_list_files() {
	# List files in a package's store path
	local method=$(__nix_get_install_method)
	
	case "$method" in
		nix-env)
			if nix-env -q | grep -q "^$@"; then
				# Package is installed, find its store path
				STORE_PATH=$(nix-env -q --out-path "$@" | awk '{print $2}')
				find "$STORE_PATH" -type f 2>/dev/null
			else
				echo "Package '$@' is not installed"
				exit 1
			fi
			;;
		nix-profile|flakes)
			# For nix profile, we need to find the package in the profile
			local profile_path=$(nix profile list | grep "$@" | awk '{print $2}')
			if [[ -n "$profile_path" ]]; then
				find "$profile_path" -type f 2>/dev/null
			else
				echo "Package '$@' is not installed"
				exit 1
			fi
			;;
	esac
}

nix_manual() {
	# Install from a local .nix file or derivation
	local method=$(__nix_get_install_method)
	
	case "$method" in
		nix-env)
			nix-env -i "$@"
			;;
		nix-profile|flakes)
			nix profile install "$@"
			;;
	esac
}

nix_repo_age() {
	# Check the age of the nix channels
	if [ -d "$HOME/.nix-defexpr/channels" ]; then
		stat -c '%Y' "$HOME/.nix-defexpr/channels"
	else
		date +%s
	fi
}

nix_repo_update() {
	if ! nix-channel --update &> /dev/null; then
		echo 'out-of-date'
		exit 1
	fi
}

nix_num_updates() {
	# Compare current generation with what would be updated
	local method=$(__nix_get_install_method)
	
	case "$method" in
		nix-env)
			nix-env -u --dry-run 2>/dev/null | grep -c "will be updated"
			;;
		nix-profile|flakes)
			nix profile diff-closures 2>/dev/null | grep -c "→" || echo "0"
			;;
	esac
}

nix_num_pkgs() { nix_list | wc -l; }

# Abstraction
########################################################################
repo_update_if_needed() {
	CURRENT_TIME=$(date '+%s')
	LAST_UPDATE=$(eval "${PKGMAN}"_repo_age)

	if ((CURRENT_TIME-LAST_UPDATE > UPDATE_AFTER)); then
		eval "${PKGMAN}"_repo_update
	fi
}

# Find the current distribution
if [[ -n "$DEFAULT_PKGMAN" ]]; then
	# Use configured package manager
	PKGMAN="$DEFAULT_PKGMAN"
elif [ -f /etc/os-release ]; then
	if grep -q -i nixos /etc/os-release; then
		PKGMAN='nix'
	elif grep -q arch /etc/os-release; then
		PKGMAN='pacman'
	elif [[ -f /etc/debian_version ]]; then
		PKGMAN='apt'
	elif grep -q void /etc/os-release; then
		PKGMAN='xbps'
	elif grep -q alpine /etc/os-release; then
		PKGMAN='apk'
	elif grep -q fedora /etc/os-release; then
		PKGMAN='dnf'
	elif grep -q openSUSE /etc/os-release; then
		# openSUSE supports dnf, but the default is zypper
		if hash dnf 2>/dev/null; then
			PKGMAN='dnf'
		else
			PKGMAN='zypper'
		fi
	else
		echo "ERROR: I currently don't have support for your distro"
		exit 1
	fi
else
	if is_darwin; then
		PKGMAN='brew'
	elif hash nix-env 2>/dev/null; then
		# Nix can be installed on non-NixOS systems
		PKGMAN='nix'
	else
		echo "Error: cannot detect platform"
		exit 1
	fi
fi

# Check for --init-config before platform detection
########################################################################
if [[ "$1" == "--init-config" ]]; then
	init_config
fi

# find what we're doing
########################################################################
# make leading dashes optional, out of tradition
if is_darwin; then
  # Detect cask argument
  if [ "$1" == "cask" ]; then
    BREW_CASK="cask"
    shift 1
  fi

  action=$(echo "$1" | sed 's/^-*//g')
else
  action=$(echo "$1" | sed 's/^-*//g' --)
fi

case "$action" in
# search
	[sS]|[sS][eE][aA][rR][cC][hH])
		shift 1
		eval ${PKGMAN}_search "$@"
		bye
	;;
# remove
	[rR]|[rR][eE][mM][oO][vV][eE])
		shift 1
		eval ${PKGMAN}_remove "$@"
		bye
	;;
# purge
	[pP]|[pP][uU][rR][gG][eE])
		shift 1
		eval ${PKGMAN}_purge "$@"
		bye
	;;
# list
	[lL]|[lL][iI][sS][tT])
		eval ${PKGMAN}_list
		bye
	;;
# list files
	[fF]|[fF][iI][lL][eE][sS])
		shift 1
		eval ${PKGMAN}_list_files "$@"
		bye
	;;
# install
	[iI]|[iI][nN][sS][tT][aA][lL][lL])
		shift 1
		repo_update_if_needed
		eval ${PKGMAN}_install "$@"
		bye
	;;
# update
	[uU]|[uU][pP][dD][aA][tT][eE])
		repo_update_if_needed
		eval ${PKGMAN}_update
		bye
	;;
# num updates
	[nN][uU]|[nN][uU][mM]-[uU][pP][dD][aA][tT][eE][sS])
		eval ${PKGMAN}_num_updates
		bye
	;;
# num packages
	[nN][pP]|[nN][uU][mM]-[pP][aA][cC][kK][aA][gG][eE][sS])
		eval ${PKGMAN}_num_pkgs
		bye
	;;
# cache
	[cC]|[cC][aA][cC][hH][eE])
		eval ${PKGMAN}_repo_update
		bye
	;;
# manual
	[mM]|[mM][aA][nN][uU][aA][lL])
		shift 1
		eval ${PKGMAN}_manual "$@"
		bye
	;;
# init-config
	--init-config)
		init_config
	;;

	*)
		usage
		bye
	;;
esac
